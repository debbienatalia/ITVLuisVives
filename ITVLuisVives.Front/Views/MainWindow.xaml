<Window x:Class="ITVLuisVives.Front.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="ITV Luis Vives - Gestión de Citas"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Segoe UI">
    
    <Window.InputBindings>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportarDatosCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportarDatosCommand}" />
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding SalirCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#FFFFFF" Padding="5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <MenuItem Header="_Archivo" Foreground="#2C3E50" Margin="5,0">
                <MenuItem Header="📤  _Exportar datos..." Command="{Binding ExportarDatosCommand}" InputGestureText="Ctrl+E"/>
                <MenuItem Header="📥  _Importar datos..." Command="{Binding ImportarDatosCommand}" InputGestureText="Ctrl+I"/>
                <Separator />
                <MenuItem Header="🚪  _Salir" Command="{Binding SalirCommand}" InputGestureText="Ctrl+Q"/>
            </MenuItem>
            <MenuItem Header="_Ayuda" Foreground="#2C3E50" Margin="5,0">
                <MenuItem Header="ℹ️  _Acerca de" Command="{Binding NavegarAcercaDeCommand}"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#2C3E50" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="15,20,15,30">
                        <TextBlock Text="ITV LUIS VIVES" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Panel de Administración" Foreground="#95A5A6" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavegarCitasCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Gestión de Citas" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavegarImportExportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Importar / Exportar" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavegarInformesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Informes Técnicos" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavegarAcercaDeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Acerca de" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="DAW — 2026" Foreground="#7F8C8D" FontSize="11" HorizontalAlignment="Center" Margin="0,10"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#FFFFFF" Margin="20" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="1" Opacity="0.06"/>
                </Border.Effect>
                
                <ContentControl Content="{Binding CurrentView}" 
                                Validation.ErrorTemplate="{x:Null}" />
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8,5">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#2ECC71" Margin="5,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Servicio Core Activo" FontSize="12" Foreground="#333333"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Background="#E0E0E0" Margin="5,0"/>
            <StatusBarItem>
                <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="12" Foreground="#7F8C8D"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding TipoBorradoStatus}" FontSize="12" FontWeight="SemiBold" Foreground="#2980B9" Margin="0,0,10,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>