<UserControl x:Class="ITVLuisVives.Front.ImportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🔄" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="Importar / Exportar Datos Centrales" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Administración física del historial de inspecciones de la ITV" FontSize="12" Foreground="#7F8C8D"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <CheckBox Content="Sustituir y purgar datos existentes en la base de datos al importar" 
                      IsChecked="{Binding SustituirDatos}"
                      FontSize="13" Foreground="#2C3E50" FontWeight="SemiBold"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Exportar Copias de Seguridad" Margin="0,0,10,0" BorderBrush="#E0E0E0">
                <StackPanel Margin="15">
                    <TextBlock Text="Guarda el estado actual del sistema en el formato deseado." TextWrapping="Wrap" Foreground="#7F8C8D" Margin="0,0,0,15"/>
                    
                    <Button Content="📤 Exportar a JSON" Command="{Binding ExportarJsonCommand}" Height="35" Background="#E67E22" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" Cursor="Hand">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                    
                    <Button Content="📤 Exportar a XML" Command="{Binding ExportarXmlCommand}" Height="35" Background="#6C5CE7" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" Cursor="Hand">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>

                    <Button Content="📤 Exportar a CSV" Command="{Binding ExportarCsvCommand}" Height="35" Background="#10AC84" Foreground="White" FontWeight="Bold" Cursor="Hand">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Restaurar / Cargar Datos" Margin="10,0,0,0" BorderBrush="#E0E0E0">
                <StackPanel Margin="15">
                    <TextBlock Text="Carga registros externos en diversos formatos al sistema." TextWrapping="Wrap" Foreground="#7F8C8D" Margin="0,0,0,15"/>
                    
                    <Button Content="📥 Importar desde JSON" Command="{Binding ImportarJsonCommand}" Height="35" Background="#E67E22" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" Cursor="Hand">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>

                    <Button Content="📥 Importar desde XML" Command="{Binding ImportarXmlCommand}" Height="35" Background="#6C5CE7" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" Cursor="Hand">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>

                    <Button Content="📥 Importar desde CSV" Command="{Binding ImportarCsvCommand}" Height="35" Background="#10AC84" Foreground="White" FontWeight="Bold" Cursor="Hand">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                </StackPanel>
            </GroupBox>
        </Grid>

        <Border Grid.Row="3" Background="#F1F2F6" Padding="10" CornerRadius="4" Margin="0,15,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#2980B9"/>
        </Border>
    </Grid>
</UserControl>